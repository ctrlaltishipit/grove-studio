# ---------------------------------------------------------------------------
# Grove — client environment. Copy to .env.local and fill in.
# ONLY VITE_-prefixed variables belong in this file. Anything prefixed VITE_
# is compiled into the browser bundle and is public by definition.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or LLM_API_KEY here. They live only in
# Vercel project settings, and are read only by api/synthesise.py.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave UNSET in production. Polling is the shipping configuration.
# VITE_USE_REALTIME=false
