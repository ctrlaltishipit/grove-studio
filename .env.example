# ---------------------------------------------------------------------------
# GroveStudio — environment. Copy to .env.local and fill in.
#
# TWO kinds of variable live here:
#   VITE_*   are compiled into the browser bundle and are PUBLIC by design.
#   the rest are read ONLY by the studio sidecar (server/index.mjs) via
#            node --env-file-if-exists=.env.local. They are NEVER shipped to
#            the browser. Keep the secret ones out of any VITE_ name, forever.
# ---------------------------------------------------------------------------

# --- client (public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- studio sidecar (server-only) ---
# The sidecar reads notes under the caller's JWT, so it also needs the URL +
# anon key (same values as above). No service-role key is used anywhere.
SUPABASE_URL=

# Google Gemini — ask, summary, mind map, and the audio overview (script+TTS).
# A Google AI Studio key. LLM_API_KEY is the name; GEMINI_API_KEY also works.
LLM_API_KEY=
# Optional overrides (sensible defaults are built in):
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_TTS_MODEL=gemini-3.1-flash-tts-preview

# Anthropic Claude — the video-overview slides and the infographic designer.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Optional: change the sidecar port (Vite proxies /api to it).
# STUDIO_PORT=8787

# --- email invites (SMTP, server-only) ---
# Fill these to send invite emails (a join link + code) when someone invites a
# person to a space. Until they're set, invites still add existing users and
# show the code to share by hand — no email goes out. Any SMTP provider works
# (e.g. an app password for Gmail, or SendGrid/Mailgun/Postmark SMTP creds).
# APP_URL is the base the invite link points at.
APP_URL=http://localhost:3000
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465 (implicit TLS)
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=GroveStudio <you@example.com>
