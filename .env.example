# ---------- CLIENT (inlined into the bundle by Vite — PUBLIC by design) ----------
# The anon key is publishable: RLS is the security boundary, not key secrecy.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# VITE_USE_REALTIME=false   # leave unset in production; polling is the shipping path

# ---------- SERVER ONLY (Vercel project env; NEVER prefixed VITE_) ----------
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # bypasses RLS — only api/*.py may hold it
# LLM_API_KEY=                      # Google AI Studio key
# LLM_MODEL=gemini-3.7-flash        # env var on purpose: a stale id is never found at demo time
# CRON_SECRET=                      # openssl rand -hex 32 — guards GET /api/followup
# APP_URL=https://your-app.vercel.app
# ALLOWED_ORIGIN=*

# ---------- TOOLING ONLY (your shell, never the repo) ----------
# SUPABASE_ACCESS_TOKEN=            # personal access token for scripts/gen-types.mjs
# SUPABASE_PROJECT_REF=xxxxxxxxxxxx
